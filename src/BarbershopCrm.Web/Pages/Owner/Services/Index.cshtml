@page
@model BarbershopCrm.Web.Pages.Owner.Services.IndexModel
@{
    ViewData["Title"] = "Управление услугами";
}

<h1>Управление услугами (прайс-лист)</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert--success">@Model.SuccessMessage</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Название</th>
            <th>Длительность</th>
            <th>Цена</th>
            <th>Статус</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Services)
        {
            <tr class="@(s.IsActive ? "" : "row--inactive")">
                <td>@s.Name</td>
                <td class="tnum">@s.DurationMinutes мин</td>
                <td class="tnum">@s.Price.ToString("0") ₽</td>
                <td>@(s.IsActive ? "Активна" : "Скрыта")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@s.ServiceId" class="btn btn--sm">Изменить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="divider"></div>

<h2>Добавить услугу</h2>

<form method="post" class="form-grid">
    <div class="form-group">
        <label>Название</label>
        <input asp-for="Input.Name" required class="input" />
    </div>
    <div class="form-group">
        <label>Описание</label>
        <input asp-for="Input.Description" class="input" />
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Длительность (мин)</label>
            <input asp-for="Input.DurationMinutes" type="number" min="15" step="15" required class="input" />
        </div>
        <div class="form-group">
            <label>Цена (₽)</label>
            <input asp-for="Input.Price" type="number" min="0" step="50" required class="input" />
        </div>
    </div>
    <button type="submit" class="btn">Создать услугу</button>
</form>
