@page
@using BarbershopCrm.Domain.Enums
@model BarbershopCrm.Web.Pages.Admin.Schedule.IndexModel
@{
    ViewData["Title"] = "Расписание мастеров";
    ViewData["ManagementTab"] = "schedule";
    var isOwner = Model.Current?.RoleCode == RoleCode.Owner;
    var prevDay = Model.DateValue.AddDays(-1).ToString("yyyy-MM-dd");
    var nextDay = Model.DateValue.AddDays(1).ToString("yyyy-MM-dd");
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<partial name="_ManagementTabs" />

<section class="card timeline-card">
    <header class="timeline-header">
        <div class="timeline-header__title">
            <h1 class="timeline-title">Расписание мастеров</h1>
            <div class="timeline-meta">
                @if (Model.CurrentBranch is not null)
                {
                    <span class="timeline-meta__chip">
                        <span class="timeline-meta__dot" aria-hidden="true"></span>
                        Филиал @Model.CurrentBranch.Name
                    </span>
                    <span class="timeline-meta__sep">·</span>
                }
                <span class="timeline-meta__date">@BarbershopCrm.Web.Pages.Admin.Schedule.IndexModel.FormatRussianDate(Model.DateValue)</span>
            </div>
        </div>

        <form method="get" class="timeline-toolbar">
            @if (isOwner && Model.Branches.Count > 1)
            {
                <label class="visually-hidden" for="branch-pick">Филиал</label>
                <select id="branch-pick" name="branchId" class="input" onchange="this.form.submit()">
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.BranchId" selected="@(b.BranchId == Model.BranchId)">@b.Name</option>
                    }
                </select>
            }
            <a class="btn btn--outline btn--small" asp-page="Index" asp-route-branchId="@Model.BranchId" asp-route-date="@prevDay" aria-label="Предыдущий день">←</a>
            <a class="btn btn--outline btn--small" asp-page="Index" asp-route-branchId="@Model.BranchId" asp-route-date="@today">Сегодня</a>
            <a class="btn btn--outline btn--small" asp-page="Index" asp-route-branchId="@Model.BranchId" asp-route-date="@nextDay" aria-label="Следующий день">→</a>
            <label class="timeline-datepicker">
                <span class="visually-hidden">Дата</span>
                <input type="date" id="Date" name="Date" class="input" value="@Model.DateValue.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </label>
        </form>
    </header>

    @if (Model.BranchId is null || Model.Masters.Count == 0)
    {
        <p class="muted">В этом филиале нет активных мастеров. Добавьте мастера в разделе «Мастера».</p>
    }
    else
    {
        <div class="timeline timeline--multi" style="--timeline-rows: @Model.TotalRows; --timeline-cols: @Model.Masters.Count;">
            <div class="timeline__head" style="grid-row: 1; grid-column: 1;">Время</div>
            @{ var col = 2; }
            @foreach (var m in Model.Masters)
            {
                <div class="timeline__head" style="grid-row: 1; grid-column: @col;">
                    <span class="timeline__master-avatar" aria-hidden="true">@(m.Persona.LastName.Length > 0 ? m.Persona.LastName[0].ToString() : "?")</span>
                    <span class="timeline__master-name">@m.Persona.ShortName</span>
                </div>
                col++;
            }

            @foreach (var h in Model.TimelineHours)
            {
                <div class="timeline__hour" style="grid-row: @(h.RowIndex + 1) / span 4; grid-column: 1;">
                    <span class="timeline__hour-label">@h.Time.ToString("HH:mm")</span>
                </div>
                var c = 2;
                foreach (var _ in Model.Masters)
                {
                    <div class="timeline__cell" style="grid-row: @(h.RowIndex + 1) / span 4; grid-column: @c;"></div>
                    c++;
                }
            }

            @{ var mc = 2; }
            @foreach (var m in Model.Masters)
            {
                if (Model.EntriesByMaster.TryGetValue(m.MasterId, out var entries))
                {
                    foreach (var e in entries)
                    {
                        if (e.Kind == BarbershopCrm.Web.Pages.Admin.Schedule.IndexModel.TimelineEntryKind.Booking && e.Booking is not null)
                        {
                            var b = e.Booking;
                            var statusCode = b.Status;
                            var statusLabel = StatusLabels.BookingStatus(statusCode);
                            <article class="timeline-entry timeline-entry--booking timeline-entry--@statusCode.ToLowerInvariant()"
                                     style="grid-row: @(e.RowStart + 1) / span @e.RowSpan; grid-column: @mc;">
                                <header class="timeline-entry__top">
                                    <div class="timeline-entry__client">@b.Client.Persona.ShortName</div>
                                    <span class="badge badge--@statusCode.ToLowerInvariant()" title="@statusLabel">@statusLabel</span>
                                </header>
                                <div class="timeline-entry__service">
                                    <span aria-hidden="true">✂</span>
                                    <span>@b.Service.Name</span>
                                </div>
                                <div class="timeline-entry__meta">
                                    @b.StartDateTime.ToString("HH:mm") – @b.StartDateTime.AddMinutes(b.DurationMinutes).ToString("HH:mm")
                                    · @BarbershopCrm.Web.Pages.Admin.Schedule.IndexModel.FormatDuration(b.DurationMinutes)
                                    · @b.PriceSnapshot.ToString("0") ₽
                                </div>
                                @if (!string.IsNullOrWhiteSpace(b.Client.Persona.Phone))
                                {
                                    <div class="timeline-entry__phone tnum">@b.Client.Persona.Phone</div>
                                }
                            </article>
                        }
                        else
                        {
                            var modifier = e.Kind.ToString().ToLowerInvariant();
                            <div class="timeline-entry timeline-entry--break timeline-entry--@modifier"
                                 style="grid-row: @(e.RowStart + 1) / span @e.RowSpan; grid-column: @mc;"
                                 aria-label="@e.Label">
                                <span class="timeline-entry__break-label">@e.Label</span>
                                <span class="timeline-entry__break-time">@e.StartTime.ToString("HH:mm") – @e.EndTime.ToString("HH:mm")</span>
                            </div>
                        }
                    }
                }
                mc++;
            }
        </div>

        <footer class="timeline-legend muted">
            <span><span class="timeline-legend__dot timeline-legend__dot--booking"></span>Запись</span>
            <span><span class="timeline-legend__dot timeline-legend__dot--lunch"></span>Перерыв</span>
            <span><span class="timeline-legend__dot timeline-legend__dot--vacation"></span>Отпуск</span>
            <span><span class="timeline-legend__dot timeline-legend__dot--sickleave"></span>Больничный</span>
        </footer>

        <p class="muted timeline-edit-hint">
            Смены и отгулы задают мастера в своём кабинете. Администратор видит расписание, но не редактирует его.
        </p>
    }
</section>
