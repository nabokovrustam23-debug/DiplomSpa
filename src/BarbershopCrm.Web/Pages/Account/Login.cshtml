@page
@model BarbershopCrm.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход в кабинет";
}

<section class="auth-shell">
    <div class="auth-card card">
        <h1>Вход в кабинет</h1>
        <p class="muted">Введите email и пароль, привязанные к аккаунту в «Тихом часе».</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="flash flash--error">@Model.ErrorMessage</div>
        }

        <form method="post" novalidate>
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" autocomplete="username" autofocus required />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password">Пароль</label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div class="auth-actions">
                <button type="submit" class="btn btn--primary">Войти</button>
                <a asp-page="/Account/ForgotPassword" class="btn-link">Забыли пароль?</a>
            </div>
        </form>

        <div class="auth-secondary">
            Нет аккаунта?
            <a asp-page="/Account/Register">Зарегистрироваться</a>
        </div>

        @if (Model.ShowQuickLogin)
        {
            <div class="quick-login">
                <div class="quick-login__title">Быстрый вход (только для разработки)</div>
                <p class="faint quick-login__hint">Тестовые учётки с паролем <code>Test12345!</code> для проверки модулей.</p>

                @foreach (var acc in Model.QuickAccounts)
                {
                    <form method="post" asp-page-handler="Quick" class="quick-login__row">
                        <input type="hidden" name="email" value="@acc.Email" />
                        <input asp-for="ReturnUrl" type="hidden" />
                        <button type="submit" class="btn btn--outline btn--sm quick-login__btn">
                            <span class="quick-login__name">@acc.Title</span>
                            <span class="quick-login__sub">@acc.Subtitle</span>
                            <span class="quick-login__email">@acc.Email</span>
                        </button>
                    </form>
                }
            </div>
        }
    </div>
</section>
