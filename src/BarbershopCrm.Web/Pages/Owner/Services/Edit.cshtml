@page "{id:int}"
@model BarbershopCrm.Web.Pages.Owner.Services.EditModel
@{
    ViewData["Title"] = "Редактирование услуги";
    ViewData["ManagementTab"] = "services";
}

<partial name="_ManagementTabs" />

<section class="card">
    <nav class="breadcrumbs faint" aria-label="Хлебные крошки">
        <a asp-page="Index">Услуги</a> ›
        <span>Редактирование</span>
    </nav>
    <h2 class="manage-tabs__heading">Редактирование услуги</h2>

    <form method="post" asp-route-id="@Model.ServiceId" class="form-grid" enctype="multipart/form-data" data-busy>
        <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

        <div class="form-group">
            <label asp-for="Input.Name">Название</label>
            <input asp-for="Input.Name" required class="input" />
            <span asp-validation-for="Input.Name" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Description">Описание</label>
            <input asp-for="Input.Description" class="input" />
            <span asp-validation-for="Input.Description" class="field-error"></span>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.DurationMinutes">Длительность (мин)</label>
                <input asp-for="Input.DurationMinutes" type="number" min="15" step="15" max="480" required class="input" />
                <span asp-validation-for="Input.DurationMinutes" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Price">Цена (₽) <span class="faint">— минимум 200, шаг 50</span></label>
                <input asp-for="Input.Price" type="number" min="200" step="50" required class="input" />
                <span asp-validation-for="Input.Price" class="field-error"></span>
            </div>
        </div>
        <div class="form-group">
            <label>Фото услуги</label>
            <div class="upload-row">
                @if (!string.IsNullOrEmpty(Model.Input.ExistingImageUrl))
                {
                    <img class="image-thumb image-thumb--capped" src="@Model.Input.ExistingImageUrl" alt="Текущая фотография услуги" />
                }
                else
                {
                    <div class="image-thumb image-thumb--capped image-placeholder" aria-hidden="true">фото нет</div>
                }
                <div class="upload-controls">
                    <input asp-for="Input.ImageFile" type="file" accept="image/jpeg,image/png,image/webp" />
                    <span class="faint">jpg/png/webp до 4&nbsp;МБ. Загрузка нового файла заменит текущее фото.</span>
                    <span asp-validation-for="Input.ImageFile" class="field-error"></span>
                    @if (!string.IsNullOrEmpty(Model.Input.ExistingImageUrl))
                    {
                        <label class="checkbox-item" style="margin-top: var(--space-2);">
                            <input asp-for="Input.RemoveImage" type="checkbox" />
                            Удалить текущее фото
                        </label>
                    }
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="checkbox-item">
                <input asp-for="Input.IsActive" type="checkbox" />
                Активна (отображается в прайс-листе)
            </label>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Сохранить</button>
            <a asp-page="Index" class="btn btn--outline">Отмена</a>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/form-busy.js" asp-append-version="true"></script>
}
