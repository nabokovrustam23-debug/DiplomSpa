@page "{id:int}"
@model BarbershopCrm.Web.Pages.Owner.Branches.EditModel
@{
    ViewData["Title"] = "Редактирование филиала";
}

<h1>Редактирование филиала</h1>

<form method="post" asp-route-id="@Model.BranchId" class="form-grid">
    <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

    <div class="form-group">
        <label>Название</label>
        <input asp-for="Input.Name" required class="input" />
        <span asp-validation-for="Input.Name" class="field-error"></span>
    </div>
    <div class="form-group">
        <label>Адрес <span class="faint">— начните вводить, появятся подсказки</span></label>
        <input asp-for="Input.Address" required class="input"
               data-address-suggest
               data-lat-target="#Input_Latitude"
               data-lon-target="#Input_Longitude" />
        <span asp-validation-for="Input.Address" class="field-error"></span>
        <input asp-for="Input.Latitude" type="hidden" id="Input_Latitude" />
        <input asp-for="Input.Longitude" type="hidden" id="Input_Longitude" />
        @if (Model.Input.Latitude.HasValue && Model.Input.Longitude.HasValue)
        {
            <small class="faint">Текущие координаты: @Model.Input.Latitude.Value.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture), @Model.Input.Longitude.Value.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture)</small>
        }
    </div>
    <div class="form-group">
        <label>Телефон</label>
        <input asp-for="Input.Phone" type="tel" class="input" />
        <span asp-validation-for="Input.Phone" class="field-error"></span>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label>Открытие</label>
            <input asp-for="Input.OpeningTime" type="time" required class="input" />
            <span asp-validation-for="Input.OpeningTime" class="field-error"></span>
        </div>
        <div class="form-group">
            <label>Закрытие</label>
            <input asp-for="Input.ClosingTime" type="time" required class="input" />
            <span asp-validation-for="Input.ClosingTime" class="field-error"></span>
        </div>
    </div>
    <div class="form-group">
        <label>
            <input asp-for="Input.IsActive" type="checkbox" />
            Активен
        </label>
    </div>
    <button type="submit" class="btn">Сохранить</button>
    <a asp-page="Index" class="btn btn--outline" style="margin-left: var(--space-3);">Отмена</a>
</form>

@section Scripts {
    <script src="~/js/address-suggest.js" asp-append-version="true"></script>
}
