@page
@model BarbershopCrm.Web.Pages.Masters.ManageModel
@{
    ViewData["Title"] = "Управление · Мастера";
    ViewData["ManagementTab"] = "masters";
    var isOwner = Model.Current?.RoleCode == RoleCode.Owner;
}

<partial name="_ManagementTabs" />

<section class="card" aria-labelledby="masters-list-heading">
    <div class="card__header-row">
        <h2 id="masters-list-heading">Список мастеров</h2>
        <span class="faint">Всего: @Model.Masters.Count</span>
    </div>

    @if (Model.Masters.Count == 0)
    {
        <p class="muted">Мастеров пока нет. Добавьте первого ниже.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">ФИО</th>
                    <th scope="col">Филиал</th>
                    <th scope="col">Услуги</th>
                    <th scope="col">Статус</th>
                    <th scope="col"><span class="visually-hidden">Действия</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Masters)
                {
                    <tr class="@(m.IsActive ? "" : "row--inactive")">
                        <td>@m.Persona.FullName</td>
                        <td>@m.Branch.Name</td>
                        <td class="faint">@(m.MasterServices.Any() ? string.Join(", ", m.MasterServices.Select(ms => ms.Service.Name)) : "—")</td>
                        <td>@(m.IsActive ? "Активен" : "Неактивен")</td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@m.MasterId" class="btn btn--sm" aria-label="Изменить мастера @m.Persona.FullName">Изменить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card" aria-labelledby="masters-add-heading">
    <h2 id="masters-add-heading">Добавить мастера</h2>

    <form method="post" class="form-grid" data-busy>
        <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.LastName">Фамилия</label>
                <input asp-for="Input.LastName" required class="input" autofocus />
                <span asp-validation-for="Input.LastName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.FirstName">Имя</label>
                <input asp-for="Input.FirstName" required class="input" />
                <span asp-validation-for="Input.FirstName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.MiddleName">Отчество <span class="faint">(необязательно)</span></label>
                <input asp-for="Input.MiddleName" class="input" />
                <span asp-validation-for="Input.MiddleName" class="field-error"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Input.Phone">Телефон</label>
                <input asp-for="Input.Phone" type="tel" required class="input" placeholder="+7 (918) 000-11-22" />
                <span asp-validation-for="Input.Phone" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Email">Email <span class="faint">(необязательно)</span></label>
                <input asp-for="Input.Email" type="email" class="input" placeholder="example@thq.ru" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
            @if (isOwner)
            {
                <div class="form-group">
                    <label asp-for="Input.BranchId">Филиал</label>
                    <select asp-for="Input.BranchId" class="input" required>
                        <option value="">— выберите —</option>
                        @foreach (var b in Model.Branches)
                        {
                            <option value="@b.BranchId">@b.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.BranchId" class="field-error"></span>
                </div>
            }
        </div>

        <div class="form-group">
            <label>Услуги мастера <span class="faint">(минимум одна)</span></label>
            @if (Model.AllServices.Count == 0)
            {
                <p class="muted">Нет активных услуг. Сначала создайте услугу в разделе «Услуги».</p>
            }
            else
            {
                <div class="checkbox-grid">
                    @foreach (var service in Model.AllServices)
                    {
                        var isChecked = Model.Input.SelectedServiceIds.Contains(service.ServiceId);
                        <label class="checkbox-item">
                            <input type="checkbox"
                                   name="Input.SelectedServiceIds"
                                   value="@service.ServiceId"
                                   @(isChecked ? "checked" : "") />
                            @service.Name <span class="faint">(@service.DurationMinutes мин, @service.Price.ToString("0") ₽)</span>
                        </label>
                    }
                </div>
            }
            <span asp-validation-for="Input.SelectedServiceIds" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary" disabled="@(Model.AllServices.Count == 0)">Добавить мастера</button>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/form-busy.js" asp-append-version="true"></script>
}
