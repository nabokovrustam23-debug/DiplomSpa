@page "/Admin/Leads"
@using BarbershopCrm.Domain.Enums
@model BarbershopCrm.Web.Pages.Admin.Leads.IndexModel
@{
    ViewData["Title"] = "Заявки";
    ViewData["ManagementTab"] = "leads";
}

<partial name="_ManagementTabs" />

<section class="card">
    <h1>Заявки от клиентов и гостей</h1>

    <form method="get" class="form-row">
        <div class="form-group">
            <label for="Status">Статус</label>
            <select id="Status" name="Status" class="input" onchange="this.form.submit()">
                <option value="">Все</option>
                @foreach (var s in Model.StatusOptions)
                {
                    <option value="@s" selected="@(Model.Status == s)">@StatusLabels.LeadStatus(s)</option>
                }
            </select>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <p class="muted">Заявок нет.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th scope="col">Создана</th><th scope="col">Имя</th><th scope="col">Телефон</th><th scope="col">Филиал</th><th scope="col">Комментарий</th><th scope="col">Статус</th><th scope="col">Действия</th></tr>
            </thead>
            <tbody>
            @foreach (var l in Model.Items)
            {
                <tr>
                    <td>@l.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@l.RawName</td>
                    <td>@l.RawPhone</td>
                    <td>@(l.PreferredBranch?.Name ?? "—")</td>
                    <td>@l.Comment</td>
                    <td><span class="badge badge--@l.Status.ToLowerInvariant()">@StatusLabels.LeadStatus(l.Status)</span></td>
                    <td class="booking-actions">
                        @if (l.Status != LeadStatus.Done && l.Status != LeadStatus.Rejected)
                        {
                            <a class="btn btn--primary btn--small" asp-page="/Admin/Bookings/New" asp-route-leadId="@l.LeadId">Создать запись</a>
                        }
                        @if (l.Status == LeadStatus.New)
                        {
                            <form method="post" asp-page-handler="Take" asp-route-id="@l.LeadId" data-busy>
                                <button class="btn btn--outline btn--small" type="submit">В работу</button>
                            </form>
                        }
                        @if (l.Status != LeadStatus.Done && l.Status != LeadStatus.Rejected)
                        {
                            <form method="post" asp-page-handler="Done" asp-route-id="@l.LeadId" data-busy>
                                <button class="btn btn--outline btn--small" type="submit">Обработана</button>
                            </form>
                            <form method="post" asp-page-handler="Reject" asp-route-id="@l.LeadId" data-busy onsubmit="return confirm('Отклонить заявку?')">
                                <button class="btn btn--danger btn--small" type="submit">Отклонить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@section Scripts {
    <script src="~/js/form-busy.js" asp-append-version="true"></script>
}
