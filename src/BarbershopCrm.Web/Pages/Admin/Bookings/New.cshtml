@page "/Admin/Bookings/New"
@model BarbershopCrm.Web.Pages.Admin.Bookings.NewModel
@{
    ViewData["Title"] = "Новая запись";
    ViewData["ManagementTab"] = "bookings";
}

<partial name="_ManagementTabs" />

<section class="card">
    <h1>Создать запись вручную</h1>
    <p class="muted">Используйте при оформлении по звонку. Источник записи будет «Admin».</p>

    <div asp-validation-summary="All" class="alert alert--error"></div>

    <form method="post" data-busy class="form-grid">
        <div class="form-group">
            <label asp-for="Input.BranchId">Филиал</label>
            <select asp-for="Input.BranchId" asp-items="Model.Branches" class="input">
                <option value="">— выберите —</option>
            </select>
            <span asp-validation-for="Input.BranchId" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.ServiceId">Услуга</label>
            <select asp-for="Input.ServiceId" asp-items="Model.Services" class="input">
                <option value="">— выберите —</option>
            </select>
            <span asp-validation-for="Input.ServiceId" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.MasterId">Мастер</label>
            <select asp-for="Input.MasterId" asp-items="Model.Masters" class="input">
                <option value="">— выберите филиал/услугу —</option>
            </select>
            <span asp-validation-for="Input.MasterId" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.StartDateTime">Дата и время</label>
            <input asp-for="Input.StartDateTime" type="datetime-local" class="input" step="900" />
            <span asp-validation-for="Input.StartDateTime" class="field-validation-error"></span>
            <small class="faint">Шаг 15 минут. Время должно укладываться в смену мастера.</small>
        </div>
        <h2>Клиент</h2>
        <div class="form-group">
            <label asp-for="Input.LastName">Фамилия</label>
            <input asp-for="Input.LastName" class="input" autocomplete="family-name" />
            <span asp-validation-for="Input.LastName" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.FirstName">Имя</label>
            <input asp-for="Input.FirstName" class="input" autocomplete="given-name" />
            <span asp-validation-for="Input.FirstName" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Phone">Телефон</label>
            <input asp-for="Input.Phone" class="input" autocomplete="tel" placeholder="+7 (900) 000-00-00" />
            <span asp-validation-for="Input.Phone" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Email">Email (необязательно)</label>
            <input asp-for="Input.Email" class="input" type="email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">Создать запись</button>
            <a asp-page="/Admin/Bookings/Index" class="btn btn--outline">Отмена</a>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/form-busy.js" asp-append-version="true"></script>
}
